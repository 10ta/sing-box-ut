@@ -0,0 +1,26 @@
+package option
+
+// ut: XHTTP downloadSettings (sing-box-ut addition on top of sing-box-lx).
+//
+// V2RayXHTTPDownloadOptions sends the download half of a split XHTTP mode
+// (stream-up, packet-up) to another server, like Xray's
+// xhttpSettings.downloadSettings: its own address, TLS and XHTTP request
+// options, and its own XMUX pool. Nothing is inherited from the upload side —
+// Xray builds downloadSettings as a complete stream config too — except the
+// outbound's dialer and the session id, which both halves must share.
+//
+// Mode and download are taken from the upload side and must stay empty here.
+//
+//	"transport": {
+//	  "type": "xhttp", "mode": "stream-up", "path": "/up/", ...,
+//	  "download": {
+//	    "server": "down.example.com", "server_port": 443,
+//	    "tls": { "enabled": true, "server_name": "down.example.com", ... },
+//	    "path": "/down/", "x_padding_bytes": "100-1000", ...
+//	  }
+//	}
+type V2RayXHTTPDownloadOptions struct {
+	ServerOptions
+	OutboundTLSOptionsContainer
+	V2RayXHTTPOptions
+}
